# Copie este archivo como .env y ajuste los valores. El .env NUNCA se sube a Git.

# --- MySQL ---
# Estos valores son los del MySQL que usted tenga instalado. Con Docker no se usan:
# el compose levanta su propio MySQL con DOCKER_DB_PASSWORD (por defecto carro_paro_local)
# en el puerto 3307. No deje DB_PASSWORD con un valor pensado para Docker si va a
# trabajar de forma nativa, ni al revés.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=carro_paro_db

# --- Seguridad ---
ENTORNO=desarrollo                # en produccion la API exige JWT_SECRETO
JWT_SECRETO=cambie-esto-por-una-cadena-larga-y-aleatoria
JWT_MINUTOS_EXPIRACION=30
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO=15
MINUTOS_INACTIVIDAD=15
SESION_UNICA=1                    # 1 = al entrar desde otro lugar se cierra la sesión anterior; 0 = se permiten varias
# Clave con la que se cifra el secreto del segundo factor. Si se omite se deriva de JWT_SECRETO.
# Generar:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLAVE_CIFRADO=

# --- Identidad institucional y correo ---------------------------------------
# Dominios admitidos al CREAR usuarios. Vacío = cualquier dominio válido.
# Las cuentas ya creadas siguen entrando aunque después se restrinja la lista.
DOMINIOS_CORREO=
CORREO_INSTITUCION=Hospital Universitario San Rafael

# Cómo se envían los correos:
#   archivo      guarda cada mensaje en data/correo_saliente (no envía nada) <- por defecto
#   smtp         envía de verdad
#   desactivado  no hace nada
CORREO_MODO=archivo

# Microsoft 365 / Outlook. Para Gmail: smtp.gmail.com, puerto 587, con clave de aplicación.
SMTP_HOST=smtp.office365.com
SMTP_PUERTO=587
SMTP_SSL=false                    # false = STARTTLS (587); true = SSL directo (465)
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_TIMEOUT=20
CORREO_REMITENTE=                 # si se omite, se usa SMTP_USUARIO

# Segundo factor enviado al correo
MFA_CORREO_MINUTOS=10
MFA_CORREO_MAX_INTENTOS=5

# --- Inicio de sesión con Microsoft (Entra ID) ------------------------------
# Se obtienen al registrar la aplicación. Ver docs/CORREO_Y_SSO.md
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common               # el ID del directorio de la institución
MS_REDIRECT_URI=http://localhost:8501
# Vacío = solo entran cuentas ya creadas. Con un rol, las crea automáticamente.
MS_ROL_POR_DEFECTO=

# --- Registro de usuarios por cuenta propia ---
REGISTRO_ABIERTO=true
# Vacío = la cuenta queda esperando que un administrador le asigne el perfil.
# Con un rol (p. ej. MEDICO) se activa sola al verificar el correo.
REGISTRO_ROL_INICIAL=
REGISTRO_MINUTOS_CODIGO=20

# --- Reglas de negocio ---
DIAS_PROXIMO_VENCER=30

# --- Big Data ---
MOTOR_BIGDATA=spark               # spark | pandas
SPARK_DRIVER_MEMORY=2g
# URL del dataset CUM en datos.gov.co (verifique el identificador vigente del recurso)
CUM_API_URL=https://www.datos.gov.co/resource/i7cb-raxc.json

# --- Agente IA ---
AGENTE_PROVEEDOR=reglas           # reglas | llm
# Para AGENTE_PROVEEDOR=llm con Ollama local:
LLM_URL=http://localhost:11434/v1
LLM_MODELO=qwen3:8b
LLM_API_KEY=
LLM_TIMEOUT=180
HF_TOKEN=
HF_MODELO=
ANTHROPIC_API_KEY=

# Segundo factor (app de autenticación): MFA_VENTANA 0 = solo el código actual (1 = ±30 s);
# MFA_PENDIENTE_MINUTOS = espera máxima en la pantalla del código antes de volver al inicio
MFA_VENTANA=0
MFA_PENDIENTE_MINUTOS=2
