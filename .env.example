# Copie este archivo como .env y ajuste los valores. El .env NUNCA se sube a Git.

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=carro_paro_db

# --- Seguridad ---
ENTORNO=desarrollo                # en produccion la API exige JWT_SECRETO
JWT_SECRETO=cambie-esto-por-una-cadena-larga-y-aleatoria
JWT_MINUTOS_EXPIRACION=30
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO=15
MINUTOS_INACTIVIDAD=15

# --- Reglas de negocio ---
DIAS_PROXIMO_VENCER=30

# --- Big Data ---
MOTOR_BIGDATA=spark               # spark | pandas
SPARK_DRIVER_MEMORY=2g
# URL del dataset CUM en datos.gov.co (verifique el identificador vigente del recurso)
CUM_API_URL=https://www.datos.gov.co/resource/i7cb-raxc.json

# --- Agente IA ---
AGENTE_PROVEEDOR=reglas           # reglas | llm
# Para AGENTE_PROVEEDOR=llm con Ollama local:
LLM_URL=http://localhost:11434/v1
LLM_MODELO=qwen2.5:7b
LLM_API_KEY=
LLM_TIMEOUT=180
HF_TOKEN=
HF_MODELO=
ANTHROPIC_API_KEY=
